# ───────── FRONTEND (safe to be public). Goes in .env.local, and in your deploy settings. ─────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# ───────── BACKEND SECRETS. NEVER put these in a VITE_ variable or in Git. ─────────
# Set with:  supabase secrets set --env-file supabase/.env   (supabase/.env is git-ignored)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.
TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
TELEGRAM_ADMIN_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=a-long-random-string-A-Z-a-z-0-9-_-
CRON_SECRET=another-long-random-string
# Exact origin(s) of the portfolio, comma separated, no trailing slash, no path.
ALLOWED_ORIGIN=https://YOUR-NAME.github.io
# Full public address of the site, used to build invitation links (include the /Biruk-Solomon path).
PUBLIC_SITE_URL=https://YOUR-NAME.github.io/Biruk-Solomon



